API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Server-only -- used by app/api/cron/trigger-pipeline to call apps/api's cron-guarded
# pipeline endpoint. Must match apps/api's own CRON_SECRET.
CRON_SECRET=
# Optional extra layer: if set, the cron route also requires this exact bearer token on the
# incoming request (Vercel Cron invocations can be configured to send it).
VERCEL_CRON_SECRET=
