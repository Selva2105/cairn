{
  "name": "@cairn/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@prisma/client": "6.19.3"
  },
  "nx": {
    "tags": [
      "scope:shared",
      "type:data"
    ],
    "targets": {
      "migrate": {
        "command": "prisma migrate dev",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      },
      "generate": {
        "command": "prisma generate",
        "options": {
          "cwd": "{workspaceRoot}"
        }
      }
    }
  }
}
