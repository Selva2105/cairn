{
  "name": "cairn",
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prepare": "husky",
    "reset": "pnpm exec nx reset && pnpm dev:down && pnpm dev:up",
    "dev": "NX_TUI=false concurrently -n api,worker,web -c blue,magenta,green \"nx run-many -t serve -p api,worker --parallel=2 --output-style=stream\" \"wait-on http://localhost:3000/api/health && nx run web:dev\"",
    "dev:api": "NX_TUI=false nx serve api --output-style=stream",
    "dev:worker": "NX_TUI=false nx serve worker --output-style=stream",
    "dev:bot": "NX_TUI=false nx serve bot --output-style=stream",
    "dev:web": "NX_TUI=false nx run web:dev --output-style=stream",
    "ngrok": "ngrok http --url=secret-motivator-jukebox.ngrok-free.dev 3000",
    "dev:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dev:down": "docker compose -f infra/docker/docker-compose.yml down",
    "build": "nx run-many -t build --projects=api,worker,web",
    "typecheck": "nx run-many -t typecheck --all",
    "lint": "nx run-many -t lint --all",
    "test": "nx run-many -t test --all",
    "e2e": "nx run web-e2e:e2e",
    "verify": "nx run-many -t typecheck,lint,test,build --all",
    "sync": "nx sync",
    "db:generate": "prisma generate --schema=prisma/schema",
    "db:migrate": "prisma migrate dev --schema=prisma/schema",
    "db:migrate:name": "prisma migrate dev --schema=prisma/schema --name",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema",
    "db:migrate:status": "prisma migrate status --schema=prisma/schema",
    "db:migrate:reset": "prisma migrate reset --schema=prisma/schema",
    "db:studio": "prisma studio --schema=prisma/schema"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
