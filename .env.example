# Two real env files exist locally, both gitignored: .env.local (local dev -- Docker Compose
# Postgres/Redis, mailpit for SMTP) takes precedence over .env (live Render/Vercel creds --
# Neon, Upstash, a real SMTP relay). This file is just the shared shape/example for both.
DATABASE_URL=postgresql://cairn:cairn@localhost:5432/cairn
# Neon needs a separate unpooled URL for `prisma migrate` -- locally, same as DATABASE_URL
# (no pooler in the loop). See docs/adr/0008-deployment-topology.md.
DIRECT_DATABASE_URL=postgresql://cairn:cairn@localhost:5432/cairn
REDIS_URL=redis://localhost:6380

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

GOOGLE_OAUTH_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=<your-google-client-secret>
# Must include the /api prefix -- apps/web proxies /api/* through to apps/api (see
# docs/adr/0009-cross-domain-auth-proxy.md), and Google redirects to this URL directly.
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
COOKIE_DOMAIN=localhost

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

SMTP_HOST=localhost
SMTP_PORT=11025
# Only needed for an authenticated relay (e.g. Brevo) in production -- mailpit locally takes none.
SMTP_USER=
SMTP_PASSWORD=

CRON_SECRET=
WEB_APP_ORIGIN=http://localhost:4200
