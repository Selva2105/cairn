# syntax=docker/dockerfile:1
FROM node:24-alpine AS build
WORKDIR /workspace
ENV HUSKY=0
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec nx build api

# apps/api's webpack config doesn't emit a prod package.json (generatePackageJson: false), so
# there's nothing for a separate `pnpm install --prod` to act on in this stage -- copy the
# build stage's already-installed node_modules straight through instead.
FROM node:24-alpine AS runtime
WORKDIR /app
RUN addgroup -S cairn && adduser -S cairn -G cairn
COPY --from=build /workspace/apps/api/dist ./
COPY --from=build /workspace/node_modules ./node_modules
# Prisma's native query-engine binary lives outside node_modules, at the generator's custom
# `output` path (see prisma/schema/schema.prisma) -- webpack only bundles JS, so without this
# copy the engine .node file never makes it into the image and PrismaClient fails at boot.
COPY --from=build /workspace/libs/database/src/generated/client ./libs/database/src/generated/client
USER cairn
EXPOSE 3000
CMD ["node", "main.js"]
