# syntax=docker/dockerfile:1
FROM node:24-alpine AS build
WORKDIR /workspace
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec nx build worker

FROM node:24-alpine AS runtime
WORKDIR /app
RUN addgroup -S cairn && adduser -S cairn -G cairn
COPY --from=build /workspace/dist/apps/worker ./
RUN corepack enable && pnpm install --prod --frozen-lockfile || true
USER cairn
CMD ["node", "main.js"]
